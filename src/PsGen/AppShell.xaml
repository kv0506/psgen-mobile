<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PsGen.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PsGen.Mobile.Views"
    Title="PsGen"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Accounts" Icon="key.svg">
        <ShellContent ContentTemplate="{DataTemplate views:AccountsPage}" Route="AccountsPage" />
    </FlyoutItem>

    <FlyoutItem Title="Generate Password" Icon="key.svg">
        <ShellContent ContentTemplate="{DataTemplate views:GeneratePasswordPage}" Route="GeneratePasswordPage" />
    </FlyoutItem>

    <MenuItem Text="Logout" Clicked="OnLogoutClicked" />

</Shell>
