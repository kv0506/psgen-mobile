<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PsGen.Mobile.Views.GeneratePasswordPage"
             Title="Generate Password">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="15">

            <Label x:Name="AccountLabel" FontSize="18" FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" IsVisible="False" />

            <Label Text="Pattern" FontSize="14" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="PatternEntry" Placeholder="Enter your secret pattern"
                       IsPassword="True" />
                <ImageButton Grid.Column="1" Source="eye.svg"
                             WidthRequest="30" HeightRequest="30"
                             Clicked="OnTogglePatternVisibility"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center" Margin="5,0,0,0" />
            </Grid>

            <Label Text="PIN" FontSize="14" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,Auto">
                <Entry x:Name="PinEntry" Placeholder="4-8 digit PIN"
                       IsPassword="True" Keyboard="Numeric" MaxLength="8" />
                <ImageButton Grid.Column="1" Source="eye.svg"
                             WidthRequest="30" HeightRequest="30"
                             Clicked="OnTogglePinVisibility"
                             BackgroundColor="Transparent"
                             VerticalOptions="Center" Margin="5,0,0,0" />
            </Grid>

            <Label Text="Length" FontSize="14" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,60">
                <Slider x:Name="LengthSlider" Minimum="8" Maximum="44" Value="20"
                        ValueChanged="OnLengthChanged" />
                <Label x:Name="LengthLabel" Grid.Column="1" Text="20"
                       VerticalOptions="Center" HorizontalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Include Special Character" VerticalOptions="Center" />
                <Switch x:Name="IncludeSpecialSwitch" Grid.Column="1" IsToggled="True"
                        Toggled="OnIncludeSpecialToggled" />
            </Grid>

            <Grid x:Name="CustomSpecialSection" ColumnDefinitions="*,Auto">
                <Label Text="Use Custom Special Char" VerticalOptions="Center" />
                <Switch x:Name="UseCustomSpecialSwitch" Grid.Column="1" IsToggled="False"
                        Toggled="OnUseCustomSpecialToggled" />
            </Grid>

            <Entry x:Name="CustomSpecialCharEntry"
                   Placeholder="Special character (e.g. #)"
                   MaxLength="1"
                   IsVisible="False" />

            <!-- Generate button -->
            <Button Text="Generate Password"
                    Clicked="OnGenerateClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8" />

            <!-- Result section -->
            <Border x:Name="ResultFrame" IsVisible="False" Padding="15"
                    StrokeShape="RoundRectangle 8"
                    Stroke="{StaticResource Primary}"
                    BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#2D1F5E}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Generated Password" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <Label x:Name="PasswordLabel" FontSize="16"
                               FontFamily="OpenSansRegular"
                               VerticalOptions="Center"
                               LineBreakMode="CharacterWrap" />
                        <ImageButton Grid.Column="1" Source="eye.svg"
                                     WidthRequest="30" HeightRequest="30"
                                     Clicked="OnTogglePasswordVisibility"
                                     BackgroundColor="Transparent"
                                     VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="Copy"
                                Clicked="OnCopyPassword"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                HeightRequest="40"
                                CornerRadius="5"
                                Padding="15,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Save as account button (when loaded from existing account) -->
            <Button x:Name="SaveAccountButton" Text="Save Account"
                    IsVisible="False"
                    Clicked="OnSaveAccountClicked"
                    BackgroundColor="{StaticResource Tertiary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="8" />

            <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" FontSize="14" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
